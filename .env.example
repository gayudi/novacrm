# Copy to .env to override the local demo defaults. Never commit .env.
APP_PORT=8080
POSTGRES_DB=nova_crm
POSTGRES_USER=nova
POSTGRES_PASSWORD=local-crm-change-me
# Optional: at least 32 characters. If empty, a random secret is persisted in auth_data.
JWT_SECRET=
ENABLE_DEMO_DATA=true
ADMIN_EMAIL=admin@nova.example
ADMIN_PASSWORD=AdminDemo2026!
MANAGER_PASSWORD=ManagerDemo2026!
SALES_PASSWORD=SalesDemo2026!
# Optional AI Copilot. Backend only; never use VITE_ variables for secrets.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_KEY=
AZURE_OPENAI_DEPLOYMENT=
