{
  "name": "@nova/backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate && tsc && node -e \"require('node:fs').copyFileSync('prisma/historical-seed.sql', 'dist/prisma/historical-seed.sql')\"",
    "start": "node dist/src/server.js",
    "db:generate": "prisma generate",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "test": "tsx --test test/unit.test.ts test/copilot.test.ts",
    "test:integration": "tsx --test --test-concurrency=1 test/integration.test.ts test/historical.test.ts test/copilot-integration.test.ts test/lead-conversion.test.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "bcryptjs": "3.0.2",
    "express": "4.22.3",
    "express-rate-limit": "7.5.0",
    "helmet": "8.1.0",
    "jsonwebtoken": "9.0.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "4.17.21",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "22.15.30",
    "@types/supertest": "6.0.3",
    "prisma": "6.19.3",
    "supertest": "7.1.4",
    "tsx": "4.20.3",
    "typescript": "5.8.3"
  }
}
